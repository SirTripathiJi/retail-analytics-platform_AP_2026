PORT=3001
NODE_ENV=development

# TODO: The database integration owner must connect the central account/auth
# database. Shopkeeper business data belongs in each shopkeeper's own cluster.
CENTRAL_MONGODB_URI=
CENTRAL_MONGODB_DATABASE=

# Authentication signing secret must be set by the deployment owner.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-separated browser origins allowed by the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Global analytics timezone fallback; injected tenant settings take precedence.
BUSINESS_TIME_ZONE=UTC
