PORT=3001
NODE_ENV=development

# Central account/auth database. Keep shopkeeper operational data in tenant
# databases and keep this URI out of frontend environment variables.
CENTRAL_MONGODB_URI=
CENTRAL_MONGODB_DATABASE=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Tenant client cache settings. Registrations use the CENTRAL secret reference,
# so each business gets a separate database on the central Atlas cluster.
TENANT_DB_CACHE_LIMIT=50
TENANT_DB_IDLE_TIMEOUT_MS=600000

# Optional for a future tenant mapping configured as
# secretRef: "ENV:TENANT_MONGODB_URI__DEV". Leave empty to use CENTRAL.
TENANT_MONGODB_URI__DEV=

# Authentication signing secret must be set by the deployment owner.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-separated browser origins allowed by the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Global analytics timezone fallback; injected tenant settings take precedence.
BUSINESS_TIME_ZONE=UTC
